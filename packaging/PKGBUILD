# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oovmstat-bin
_pkgname=oovmstat
pkgver=0.1.0
pkgrel=1
pkgdesc="Reports virtual memory statistics, page faults, context switches, and IO waits."
arch=('x86_64')
url="https://github.com/openOODA-tools/oovmstat"
license=('Apache-2.0')
depends=('glibc')
provides=('oovmstat')
conflicts=('oovmstat')
source_x86_64=("${url}/releases/download/v${pkgver}/oovmstat-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oovmstat-linux-x86_64" "${pkgdir}/usr/bin/oovmstat"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oovmstat-uninstall"
}
